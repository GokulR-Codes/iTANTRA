{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iTantra dataset manifest",
  "type": "object",
  "required": ["datasetName", "sourceUrl", "license", "licenseCompatibleWithSubmission", "dateAccessed", "subsetUsed", "checksumSha256"],
  "properties": {
    "datasetName": { "type": "string" },
    "sourceUrl": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "licenseCompatibleWithSubmission": { "type": "boolean" },
    "licenseNotes": { "type": "string" },
    "dateAccessed": { "type": "string", "format": "date" },
    "subsetUsed": { "type": "string" },
    "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "usedFor": {
      "type": "array",
      "items": { "type": "string", "enum": ["stt-training", "stt-eval", "tts-training", "tts-eval", "lid-training", "lid-eval", "other"] }
    }
  }
}
